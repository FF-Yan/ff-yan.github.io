.claude/
node_modules/

# Build output: `npm run build` writes the whole site here, and the deploy
# workflow publishes it. Editing a file in it is undone by the next build.
_site/

# A folder named _private, anywhere in the repo (content/, assets/, the root…),
# stays on this computer: never committed, and never read or published by the
# build.
_private/
